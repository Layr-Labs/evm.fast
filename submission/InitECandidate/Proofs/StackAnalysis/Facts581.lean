theorem frame581_eq : InitECandidate.Proofs.StackFrameComputation.frameSize (riscvConfig.regCount - (5 + riscvConfig.avoidRegs.length)) optimized581.2.1 optimized581.2.2 = frame581 := by cbv
theorem slim581_eq : WordDepth.Executable.slim optimized581.2.2 = slim581 := by cbv
theorem frameEntry581_eq : frameEntry optimized581 = (581, frame581) := by
