theorem frame537_eq : InitECandidate.Proofs.StackFrameComputation.frameSize (riscvConfig.regCount - (5 + riscvConfig.avoidRegs.length)) optimized537.2.1 optimized537.2.2 = frame537 := by cbv
theorem slim537_eq : WordDepth.Executable.slim optimized537.2.2 = slim537 := by cbv
theorem frameEntry537_eq : frameEntry optimized537 = (537, frame537) := by
  unfold frameEntry
  rw [frame537_eq]
  rfl
theorem slimEntry537_eq : slimEntry optimized537 = (537, 2, slim537) := by
  unfold slimEntry
  rw [slim537_eq]
  rfl
#print axioms frame537_eq
#print axioms slim537_eq
end InitECandidate.Proofs.StackAnalysis
