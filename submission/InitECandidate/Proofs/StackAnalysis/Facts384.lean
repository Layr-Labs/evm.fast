      (Option.some 79) List.nil
      (Option.some { fst := 2, snd := { fst := Flapjack.WordLangProgHOL.skip, snd := { fst := 384, snd := 7 } } })))
theorem frame384_eq : InitECandidate.Proofs.StackFrameComputation.frameSize (riscvConfig.regCount - (5 + riscvConfig.avoidRegs.length)) optimized384.2.1 optimized384.2.2 = frame384 := by cbv
theorem slim384_eq : WordDepth.Executable.slim optimized384.2.2 = slim384 := by cbv
theorem frameEntry384_eq : frameEntry optimized384 = (384, frame384) := by
  unfold frameEntry
  rw [frame384_eq]
  rfl
theorem slimEntry384_eq : slimEntry optimized384 = (384, 3, slim384) := by
  unfold slimEntry
  rw [slim384_eq]
  rfl
#print axioms frame384_eq
#print axioms slim384_eq
end InitECandidate.Proofs.StackAnalysis
