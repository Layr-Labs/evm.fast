    simp only [flatExpConventions,Bool.and_eq_true] at flat
    exact flat.1
  have retMax : maxVarHOL retCode < 2*payload+2*k := by
    simp only [maxVarHOL,Flapjack.WordAlloc.max3Eq] at maximum
    omega
  have contCode : CodeBoundedW S (WordSemStateFiniteExact.setVars values returnedValues popped) :=
    CodeBoundedW.setVars _ _ (CodeBoundedW.popEnv popRun
