    aesop (config := { enableSimp := false })
  have handlerFlat : flatExpConventions handlerCode = true := by
    simp only [flatExpConventions,Bool.and_eq_true] at flat
    exact flat.2
  have handlerMax : maxVarHOL handlerCode < 2*payload+2*k := by
    simp only [maxVarHOL,Flapjack.WordAlloc.max3Eq] at maximum
    omega
  have contCode : CodeBoundedW S (WordSemStateFiniteExact.setVar handlerVar value bodyPost) :=
    CodeBoundedW.setVar _ _
      (codeBoundedW_evaluate S bodyRun (CodeBoundedW.callEnv_pushEnv args1 ss envs _ bndCode))
  obtain ⟨extraClock,targetPost,targetResult,continuationRun,conclusion,bndCont⟩ :=
    (ihB.2.1 xs args1 prog ss envs location value bodyPost ⟨guards,nonzero,bodyRun,valid,domain⟩)
