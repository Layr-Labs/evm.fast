theorem code_dm : guestCode (nm "divmnu") = some (dmParams, dmBody, .one) := by
  have h : fnEntry Guest.Software.guestFn_divmnu = (nm "divmnu", dmParams, dmBody, .one) := by
    conv => lhs; cbv
    conv => rhs; cbv
  exact code_of_entry
    (List.getElem_mem (l := Guest.Software.guestAst) (n := 67) (by decide)) ⟨_, rfl⟩ h

end InitECandidate.Solver.Divm
