theorem valid_nil : ∀ p ∈ ([] : List ShardPair), PairValid p := by intro p h; cases h

theorem valid_cons {a : ShardPair} {l : List ShardPair} (ha : PairValid a)
    (hl : ∀ p ∈ l, PairValid p) : ∀ p ∈ a :: l, PairValid p := by
  intro p hp
  rcases List.mem_cons.mp hp with rfl | hp
  · exact ha
  · exact hl p hp

