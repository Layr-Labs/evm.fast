import InitECandidate.Solver.MemSafe.ShardsR.Shard00

/-!
# The checked summary table (callee-first fold, sharded)

`tab_sound`: every entry of `tab1` (the base table `ShardsR.baseRTab`: `ShardsJL.tab26` plus the record-hook hand entries, the 25 accepted guest entries
and the mid groups, configuration `Types.guestC`) has its capability summary `CSumm` (rev. 5:
abortive results exempt), for the record hook family `guestHooksR` in the challenge context `guestCtx`.
Generated by the script `research/tools/memsafe/gen/Gen10.lean`; build the shards one at
a time. Each shard normalizes its arguments by `cbv` (the translated bodies and the names) and
then runs the checker in the kernel (`decide +kernel`); a mid step (`mid_step`) appends hand
entries whose proofs use summaries of the table so far (`ctab_get`, by position).
-/

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace InitECandidate.Solver.MemSafe.ShardsR
open InitECandidate.Solver.MemSafe.Shards
open InitECandidate.Solver.MemSafe InitECandidate.Solver.SourceCost InitECandidate.Solver.Spec
open InitECandidate.Solver.MemSafe.HtabEntries InitECandidate.Solver.MemSafe.WaveHelpers

theorem tab_soundR {σ : Type} :
    CTabSound σ guestCtx cfg (Hooks.guestHooksR (σ := σ)) tab1 :=
  have hF : FoldOK σ guestCtx cfg (Hooks.guestHooksR (σ := σ)) := Rec.foldOK_guestR
  shard_step hF chunk0_ok chunk0_valid chunk0_tab <|
  ShardsR.baseRTab_soundR

end InitECandidate.Solver.MemSafe.ShardsR
