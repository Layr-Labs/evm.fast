/-!
# The "keeps `frame_mem_ptr`" table (interface rev. 5, the SummFp flag)

`fptab_sound`: the 763 guest functions of `fptab26` keep `frame_mem_ptr` on every good,
non-abortive result (`KeepsFp`), in every guest context. Generated by the scratchpad script
`ms/GenFp.lean`; build the shards one at a time.
-/

namespace InitECandidate.Solver.MemSafe.Shards
open InitECandidate.Solver.MemSafe InitECandidate.Solver.SourceCost InitECandidate.Solver.Spec

theorem fptab_sound {σ : Type} {X : Ctx 64} (hX : X.code.lookup = guestCode) :
    FpTabSound σ X fptab26 :=
  fp_shard_step hX fpchunk25_ok fpchunk25_valid fpchunk25_tab <|
  fp_shard_step hX fpchunk24_ok fpchunk24_valid fpchunk24_tab <|
  fp_shard_step hX fpchunk23_ok fpchunk23_valid fpchunk23_tab <|
  fp_shard_step hX fpchunk22_ok fpchunk22_valid fpchunk22_tab <|
  fp_shard_step hX fpchunk21_ok fpchunk21_valid fpchunk21_tab <|
  fp_shard_step hX fpchunk20_ok fpchunk20_valid fpchunk20_tab <|
  fp_shard_step hX fpchunk19_ok fpchunk19_valid fpchunk19_tab <|
  fp_shard_step hX fpchunk18_ok fpchunk18_valid fpchunk18_tab <|
  fp_shard_step hX fpchunk17_ok fpchunk17_valid fpchunk17_tab <|
  fp_shard_step hX fpchunk16_ok fpchunk16_valid fpchunk16_tab <|
