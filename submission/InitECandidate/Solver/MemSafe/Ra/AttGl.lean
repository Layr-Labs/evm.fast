import InitECandidate.Solver.MemSafe.Eb.GlFin

/-!
# Globals kept across the callees of `run_attempt`

Three call closures (generated by an `#eval` over the guest AST): `aNames` (`validate_headers`, `check_gas_limit`, `nodedb_build`, `header_hash`,
`validate_header`, `is_valid_versioned_hashes`, `alloc`, `memeq`, `memzero`: assign only `heap_ptr`, `scratch_ptr`), `siNames` (`state_init`), `phNames`
(`payload_header`). Each theorem: a function of the closure keeps every global outside the write set.
-/

set_option autoImplicit false
set_option maxRecDepth 1000000
set_option maxHeartbeats 0
set_option cbv.maxSteps 4000000000
set_option cbv.warning false

