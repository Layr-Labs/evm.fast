theorem lookup_mem_nat : ∀ {l : List (Nat × Nat)} {t tag : Nat}, l.lookup t = some tag →
    (t, tag) ∈ l
  | [], _, _, h => by simp [List.lookup] at h
  | (a, b) :: l, t, tag, h => by
      unfold List.lookup at h
      by_cases hta : t = a
      · subst hta
        simp only [BEq.rfl, Option.some.injEq] at h
        subst h
        exact List.mem_cons_self
      · have hb : (t == a) = false := by simp [hta]
        rw [hb] at h
        exact List.mem_cons_of_mem _ (lookup_mem_nat h)

