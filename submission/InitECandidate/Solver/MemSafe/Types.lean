/-- Only the MPT node types are tagged. -/
theorem tags_lookup_none (t : Nat) (ht : t < tNHASHED ∨ tNBRANCH < t) :
    guestC.tags.lookup t = none := by
  cases h : guestC.tags.lookup t with
  | none => rfl
  | some tag =>
    have hm := lookup_mem_nat h
    simp only [guestC, guestTags, List.mem_cons, Prod.mk.injEq, List.not_mem_nil, or_false] at hm
    exfalso
    revert ht
    rcases hm with ⟨rfl, -⟩ | ⟨rfl, -⟩ | ⟨rfl, -⟩ | ⟨rfl, -⟩ <;> decide

/-- A type all of whose slots (fixed and later) have kind `k0`. -/
theorem slot_all {d : TyD} {k0 : FK} (h1 : ∀ x ∈ d.fixed, x = k0) (h2 : d.rest = k0) :
    ∀ k, d.slot k = k0 := by
  intro k
  unfold TyD.slot
  rw [List.getD_eq_getElem?_getD]
  cases hk : d.fixed[k]? with
  | none => simpa using h2
  | some x => exact h1 x (List.mem_of_getElem? hk)

