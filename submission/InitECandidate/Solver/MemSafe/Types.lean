/-! ## Owner-encoded array types (interface rev. 6) -/

/-- The type of the heap arrays of the hash table whose header is at `b`. -/
def tOwn (b : BitVec 64) : Nat := ownBase + b.toNat

theorem guestT_le_ownBase : guestT.length ≤ ownBase := by decide

/-- Owner-encoded types have the default descriptor: heap, all `prot`, minimum size 0. -/
theorem ty_own {t : Nat} (h : ownBase ≤ t) : guestC.ty t = default := by
  have := guestT_le_ownBase
  unfold Cfg.ty
  rw [List.getD_eq_getElem?_getD, List.getElem?_eq_none (by show guestT.length ≤ t; omega)]
  rfl

theorem own_prot {t : Nat} (h : ownBase ≤ t) (k : Nat) : (guestC.ty t).slot k = .prot := by
  rw [ty_own h]; rfl

theorem own_region {t : Nat} (h : ownBase ≤ t) : (guestC.ty t).region = .heap := by
  rw [ty_own h]; rfl

theorem own_minSz {t : Nat} (h : ownBase ≤ t) : (guestC.ty t).minSz = 0 := by
  rw [ty_own h]; rfl

theorem own_untagged {t : Nat} (h : ownBase ≤ t) : guestC.tags.lookup t = none := by
  have : tNBRANCH < ownBase := by decide
  exact tags_lookup_none t (Or.inr (by omega))

theorem tOwn_ge (b : BitVec 64) : ownBase ≤ tOwn b := Nat.le_add_right _ _

theorem tOwn_inj {b b' : BitVec 64} (h : tOwn b = tOwn b') : b = b' := by
  unfold tOwn at h
  exact BitVec.eq_of_toNat_eq (by omega)

