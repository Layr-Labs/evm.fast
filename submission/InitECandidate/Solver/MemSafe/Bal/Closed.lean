/-- No function of the closed set assigns `g` (for a global `g` that none of them assigns). -/
theorem balFns_gw (g : MlS) (hg : g ∈ [nm "bal_accounts", nm "bal_key_buf", nm "bal_idx_accts", nm "bal_idx_stor",
    nm "bs", nm "ts", nm "sk_buf"]) :
    balFns.all (fun e => gwFreeB g (balFns.map Prod.fst) e.2.2.1) = true := by
  simp only [List.mem_cons, List.not_mem_nil, or_false] at hg
  rcases hg with rfl | rfl | rfl | rfl | rfl | rfl | rfl <;> (conv => lhs; cbv)

/-- **A callee whose closure never assigns `g` keeps `g`'s value**: every function of `balFns` leaves the
value of the globals `bal_accounts`, `bal_key_buf`, `bal_idx_accts`, `bal_idx_stor` unchanged, whatever
the result. -/
theorem funSpec_bal_gw (hC : X.code.lookup = guestCode) {g : MlS}
    (hg : g ∈ [nm "bal_accounts", nm "bal_key_buf", nm "bal_idx_accts", nm "bal_idx_stor", nm "bs", nm "ts", nm "sk_buf"])
    {f : MlS} (hf : (balFns.map Prod.fst).contains f = true) :
    FunSpec σ X f (fun _ s _ t => t.globals.lookup g = s.globals.lookup g) := by
  intro vs body callee rs hl s hs hloc r hr
  exact funSpec_gw (g := g)
    (by rw [hC]; exact closed_of_entries (chk := gwFreeB g) balFns_valid (balFns_gw g hg))
    hf vs body callee rs hl s hs hloc r hr

end InitECandidate.Solver.MemSafe.Bal

