/-!
# What the frame loop leaves alone

**`funSpec_pm_gw`**: every function reachable from `process_message_call` (so `process_message`, `process_create_message`) keeps every global outside `pmW`
(`bn_expw`, `bn_gamma`, `cur_cont`, `ev`, `frame_mem_ptr`, `heap_ptr`, `journal_n`, `scratch_ptr`), whatever the result. Generated by
`research/tools/memsafe/gen/GenGl.py`; the check is `gwOnly` per shard (`GlOnly.lean`).
-/

set_option autoImplicit false
set_option maxRecDepth 1000000
set_option maxHeartbeats 0
set_option cbv.maxSteps 4000000000
set_option cbv.warning false

namespace InitECandidate.Solver.MemSafe.Ptx
open Flapjack Flapjack.PanSemStateFiniteExact
open Flapjack.Pancake.PanLang (ProgHOL ExpHOL MlS ShapeHOL)
open InitECandidate.Solver.SourceCost InitECandidate.Solver.Spec

variable {σ : Type} {X : Ctx 64}

def glAll : EntryList := glChunk00 ++ glChunk01 ++ glChunk02 ++ glChunk03 ++ glChunk04 ++ glChunk05 ++ glChunk06 ++ glChunk07 ++ glChunk08 ++ glChunk09 ++ glChunk10 ++ glChunk11 ++ glChunk12 ++ glChunk13 ++ glChunk14 ++ glChunk15 ++ glChunk16 ++ glChunk17 ++ glChunk18 ++ glChunk19 ++ glChunk20 ++ glChunk21 ++ glChunk22 ++ glChunk23

theorem glAll_names : glAll.map Prod.fst = pmNames := by rfl

theorem glAll_valid : ∀ e ∈ glAll, guestCode e.1 = some e.2 := by
  intro e he
  simp only [glAll, List.mem_append] at he
  rcases he with (((((((((((((((((((((((h | h) | h) | h) | h) | h) | h) | h) | h) | h) | h) | h) | h) | h) | h) | h) | h) | h) | h) | h) | h) | h) | h) | h)
  · exact glc00_valid e h
  · exact glc01_valid e h
  · exact glc02_valid e h
  · exact glc03_valid e h
  · exact glc04_valid e h
  · exact glc05_valid e h
  · exact glc06_valid e h
  · exact glc07_valid e h
  · exact glc08_valid e h
  · exact glc09_valid e h
  · exact glc10_valid e h
  · exact glc11_valid e h
  · exact glc12_valid e h
  · exact glc13_valid e h
  · exact glc14_valid e h
  · exact glc15_valid e h
  · exact glc16_valid e h
  · exact glc17_valid e h
  · exact glc18_valid e h
  · exact glc19_valid e h
  · exact glc20_valid e h
  · exact glc21_valid e h
  · exact glc22_valid e h
  · exact glc23_valid e h

theorem glAll_ok : glAll.all (fun e => gwOnly pmW (glAll.map Prod.fst) e.2.2.1) = true := by
  rw [glAll_names]
  simp only [glAll, List.all_append, glc00_ok, glc01_ok, glc02_ok, glc03_ok, glc04_ok, glc05_ok, glc06_ok, glc07_ok, glc08_ok, glc09_ok, glc10_ok, glc11_ok, glc12_ok, glc13_ok, glc14_ok, glc15_ok, glc16_ok, glc17_ok, glc18_ok, glc19_ok, glc20_ok, glc21_ok, glc22_ok, glc23_ok, Bool.and_self]

/-- **Every function of the closure keeps every global outside `pmW`.** -/
theorem funSpec_pm_gw (hC : X.code.lookup = guestCode) {g : MlS} (hg : pmW.contains g = false) {f : MlS}
    (hf : pmNames.contains f = true) :
    FunSpec σ X f (fun _ s _ t => t.globals.lookup g = s.globals.lookup g) := by
  refine funSpec_gw (S := pmNames) (g := g) ?_ hf
  rw [hC]
  intro f' hf' ps b rs hcode
  have := closed_of_entries (chk := fun S b => gwOnly pmW S b) (fns := glAll) glAll_valid glAll_ok f'
    (by rw [glAll_names]; exact hf') ps b rs hcode
  rw [glAll_names] at this
  exact gwFree_of_only hg b this

end InitECandidate.Solver.MemSafe.Ptx

